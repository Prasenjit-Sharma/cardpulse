{
  "version": 1,
  "source": "src/styles.css",
  "shadows": {
    "seat": "0 1px 2px rgba(16,24,40,.05), 0 1px 3px rgba(16,24,40,.07)",
    "seat-deep": "0 2px 6px rgba(16,24,40,.08), 0 14px 34px rgba(16,24,40,.14)",
    "sheet": "0 -10px 40px rgba(8,10,14,.18)",
    "cta": "0 1px 2px rgba(16,24,40,.08), 0 6px 16px color-mix(in srgb, var(--brand) 22%, transparent)"
  },
  "focus": {
    "field": "border-color: var(--brand); background: var(--sleeve); box-shadow: 0 0 0 3px var(--brand-wash)",
    "global": "outline: 2px solid var(--brand); outline-offset: 2px"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "durations": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "press": "transform: scale(.98)",
    "reducedMotion": "all animation and transition durations collapse to ~0"
  },
  "tabBar": { "backdrop": "saturate(1.4) blur(14px)", "background": "color-mix(in srgb, var(--sleeve) 92%, transparent)" },
  "accent": { "userSelectable": true, "source": "src/lib/accents.ts", "default": "graphite" }
}
